<Project>
  <!-- Settings shared by every project in the repository. Folder-level Directory.Build.props files import this one. -->
  <PropertyGroup Label="Compiler">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Always on: the IDE0005 (unused usings) analyzer only runs on build when a documentation file is generated. Non-package projects suppress CS1591. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Version">
    <!--
      One version for the three packages. Releases are tag-driven: pushing the tag v1.2.3 runs .github/workflows/publish.yml, which checks that the
      tag equals VersionPrefix and publishes 1.2.3. Anything else that packs (the ci workflow, a local pack) gets a pre-release suffix from the
      SMTP2GO_VERSION_SUFFIX environment variable (ci sets preview.<run number>); leave it unset for a release build. See docs/contributing.md, "Releasing".
    -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(SMTP2GO_VERSION_SUFFIX)' != ''">$(SMTP2GO_VERSION_SUFFIX)</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible builds">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="NuGet restore">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Wouter Dingemanse</Authors>
    <Company>Scott-Software</Company>
    <Copyright>Copyright (c) Wouter Dingemanse</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Jogai/Mail.Smtp2Go</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Jogai/Mail.Smtp2Go</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- docs/nuget-readme.md, packed as README.md by src/Directory.Build.props: the repository README trimmed to install, quick start and links. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- PackageTags are set per project. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
