<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <Description>Client for the SMTP2GO v3 API: email sending, webhooks, reporting, templates, suppressions, archive, account management and SMS.</Description>
    <PackageTags>smtp2go;email;transactional;api;webhooks;mail;client;sms</PackageTags>
    <!-- netstandard2.0: also polyfill the trimming annotations (DynamicallyAccessedMembers etc.) so the source compiles unchanged on every target. -->
    <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
  </PropertyGroup>

  <!--
    Derived records get a covariant <Clone>$ override on net8.0+ but a base-typed one on netstandard2.0 (no runtime support for covariant returns),
    so those lines live in per-target supplements; the analyzer merges every additional file named PublicAPI.Shipped.txt or PublicAPI.Unshipped.txt.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <AdditionalFiles Include="PublicAPI/netstandard2.0/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/netstandard2.0/PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <AdditionalFiles Include="PublicAPI/net8.0/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/net8.0/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    Compile-time generation (src/tools/Scott.Mail.Smtp2Go.Generators): the endpoint table rows come from the harvested snapshot, the
    pass-through client methods from the client interfaces, the enum wire names from the enums and the webhook record update from the event
    hierarchy. The generator runs inside the compiler only: ReferenceOutputAssembly="false" keeps it out of the references and
    PrivateAssets="all" out of the package's dependencies.
  -->
  <ItemGroup Label="Compile-time generation">
    <ProjectReference Include="..\tools\Scott.Mail.Smtp2Go.Generators\Scott.Mail.Smtp2Go.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <AdditionalFiles Include="..\..\docs\api-spec\endpoints.json" Link="endpoints.json" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scott.Mail.Smtp2Go.Tests.Unit" />
    <InternalsVisibleTo Include="Scott.Mail.Smtp2Go.Tests.Contract" />
    <InternalsVisibleTo Include="Scott.Mail.Smtp2Go.Tests.Integration" />
  </ItemGroup>

  <!-- net8.0: the in-box System.Text.Json 8 lacks JsonStringEnumMemberNameAttribute (added in 9), so the package is referenced there too. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- In-box on net10.0; packages are only needed for netstandard2.0. PolySharp generates the C# language-feature polyfills. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="PolySharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="System.Net.Http.Json" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
