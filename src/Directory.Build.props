<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Packable library defaults">
    <IsPackable>true</IsPackable>
    <!-- Package validation compares the target frameworks of each package against each other on every pack (ApiCompat). -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Baseline validation: once a version is on nuget.org, uncomment the next line, set it to the latest released version, and run
      `dotnet restore` with the force-evaluate switch (the baseline package is downloaded at restore time and lands in the lock files). From then on
      `dotnet pack` also compares each package against that release and fails on a binary or source breaking change (CP0001..CP0009);
      an intentional break goes into the project's CompatibilitySuppressions.xml with a comment. Bump the value after every release.
      It is commented out until the first release exists because there is no published 1.3.5 to compare against yet.
    <PackageValidationBaselineVersion>1.3.5</PackageValidationBaselineVersion>
    -->
  </PropertyGroup>

  <ItemGroup Label="Package content">
    <None Include="$(MSBuildThisFileDirectory)../docs/nuget-readme.md" Pack="true" PackagePath="/README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup Label="Public API tracking">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
