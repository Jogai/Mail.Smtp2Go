<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>ASP.NET Core integration for Scott.Mail.Smtp2Go: MapSmtp2GoWebhook endpoint, callback authentication, source-IP allow-list and typed event dispatch.</Description>
    <!-- Minimal-API RequestDelegate handlers and the core parser only: no reflection-based binding or serialisation, so the trim and AOT analyzers stay on. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scott.Mail.Smtp2Go.Tests.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scott.Mail.Smtp2Go\Scott.Mail.Smtp2Go.csproj" />
  </ItemGroup>

</Project>
