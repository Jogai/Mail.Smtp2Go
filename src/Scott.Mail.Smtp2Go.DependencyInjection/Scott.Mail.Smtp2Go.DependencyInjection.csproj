<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Microsoft.Extensions.DependencyInjection integration for Scott.Mail.Smtp2Go: AddSmtp2Go, options binding and validation, resilience pipeline, named clients.</Description>
    <PackageTags>smtp2go;email;transactional;api;webhooks;dependency-injection;resilience;hosting</PackageTags>
    <!-- Options binding is source generated (interceptors) so the package stays trim- and AOT-safe. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- SYSLIB1100/1101: Smtp2GoOptions.AdditionalJsonTypeInfoResolver is an interface and deliberately not bindable from configuration; the generator skips it. -->
    <NoWarn>$(NoWarn);SYSLIB1100;SYSLIB1101</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scott.Mail.Smtp2Go.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scott.Mail.Smtp2Go\Scott.Mail.Smtp2Go.csproj" />
  </ItemGroup>

</Project>
