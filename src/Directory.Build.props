<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Packable library defaults">
    <IsPackable>true</IsPackable>
    <!-- Package validation compares the target frameworks of each package against each other on every pack (ApiCompat). -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Baseline validation: `dotnet pack` also compares each package against this released version and fails on a binary or source breaking
      change (CP0001..CP0009); an intentional break goes into the project's CompatibilitySuppressions.xml with a comment. Set it to the
      latest version on nuget.org after every release. The baseline package is downloaded at restore time and is not recorded in the
      lock files; a VersionPrefix bump is, through the project references, so run `dotnet restore` with the force-evaluate switch after one.
    -->
    <PackageValidationBaselineVersion>1.3.6</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup Label="Package content">
    <None Include="$(MSBuildThisFileDirectory)../docs/nuget-readme.md" Pack="true" PackagePath="/README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup Label="Public API tracking">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
