<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <!-- Versions live here only: a VersionOverride on a PackageReference is a build error (NU1013). -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <!-- Versions are pinned exactly and bumped deliberately. Resolved on 2026-11-26 (.NET 11) with dotnet package search (exact match). -->
  <!--
    Runtime packages the libraries depend on. Only net11.0 gets the 11.0.x versions; netstandard2.0, net8.0 and net10.0 stay on the
    latest 10.0.x. A higher version here becomes the minimum for consumers: a .NET 10 (or .NET Framework) app that references one of
    these packages itself at 10.0.x would otherwise fail its restore with a package downgrade (NU1605). 10.0.x also still supports
    the deprecated net8.0, which 11.0.x does not. $(TargetFramework) is set for each inner build and each restore target framework,
    so each dependency group of the packages carries its own version. Keep the two lists in step.
  -->
  <ItemGroup Label="Library dependencies (net11.0)" Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="System.Net.Http.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <!-- Tests and demos. The test projects run on net10.0 and net11.0, each against the dependency set its users get. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <!-- In-memory TestServer for the webhook endpoint tests, at the shared framework's patch level. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="Library dependencies (netstandard2.0, net8.0, net10.0)" Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageVersion Include="System.Text.Json" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="System.Net.Http.Json" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.15" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="10.0.15" />
    <!-- Versioned apart from the runtime (dotnet/extensions); its 11.0.x would raise the minimum for .NET 10 apps the same way. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <!-- Tests and demos (see the net11.0 list). -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Core (netstandard2.0 only)">
    <PackageVersion Include="PolySharp" Version="1.17.1" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>
  <ItemGroup Label="Tools">
    <!-- Spec harvester (plan 08). -->
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <!-- Validates the merged OpenAPI document before the harvester writes it. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.1" />
  </ItemGroup>
  <ItemGroup Label="Source generators">
    <!-- The oldest compiler API the generators need, see src/tools/Scott.Mail.Smtp2Go.Generators; the analyzers package checks generator correctness (RS1xxx). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
  </ItemGroup>
</Project>