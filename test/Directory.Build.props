<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CS1591: no doc comments in tests. CA1707: underscores in test method names are the convention. -->
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
    <!-- The test runner (Microsoft.Testing.Platform) is selected in the root global.json (test.runner), as the xunit3 template does. -->
  </PropertyGroup>
</Project>
